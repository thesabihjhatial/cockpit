# Copy this file to keystore.properties and fill it in; that file is gitignored.
#
# Create the key once, and keep both the .jks and its passwords somewhere you will
# not lose them: losing them means you can no longer update an installed copy.
#
#   keytool -genkeypair -v -keystore cockpit-release.jks -alias cockpit \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Until keystore.properties exists, assembleRelease signs with the debug key.

storeFile=cockpit-release.jks
storePassword=
keyAlias=cockpit
keyPassword=
